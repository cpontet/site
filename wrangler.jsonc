{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cedricpontet",
  // "cpontet" account, which owns the cedricpontet.com zone.
  "account_id": "079789269b213c27c3cb28ea7764b6b5",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // Contact form: Email Routing must be enabled on cedricpontet.com and CONTACT_TO verified there.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Secrets (never in this public repo), set with `bunx wrangler secret put <NAME>`:
  //   CONTACT_TO            verified Email Routing destination for contact form messages
  //   TURNSTILE_SECRET_KEY  Turnstile widget secret
  "observability": { "enabled": true },
  // Apex domain served by this Worker. www → apex is a Cloudflare Redirect Rule (see README).
  "routes": [{ "pattern": "cedricpontet.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
