{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cedricpontet",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // Contact form: Email Routing must be enabled on cedricpontet.com and CONTACT_TO verified there.
  "send_email": [{ "name": "SEND_EMAIL" }],
  "vars": {
    // TODO(cedric): verified destination inbox for contact form messages.
    "CONTACT_TO": ""
  },
  // TURNSTILE_SECRET_KEY is a secret: `bunx wrangler secret put TURNSTILE_SECRET_KEY`.
  "observability": { "enabled": true },
  // Apex domain served by this Worker. www → apex is a Cloudflare Redirect Rule (see README).
  "routes": [{ "pattern": "cedricpontet.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
